{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velo Recorder",
  "version": "0.1.0",
  "identifier": "app.velo.recorder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Velo Recorder",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
